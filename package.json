{
  "name": "web-components-mache-hangar",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "turbo run dev",
    "dev:doc": "turbo run dev --filter=docs",
    "dev:components": "turbo run dev --filter=@mache-hangar/components",
    "dev:vue": "turbo run dev --filter=vue-playground",
    "dev:react": "turbo run dev --filter=react-playground",
    "build": "turbo run build",
    "build:doc": "turbo run build --filter=docs",
    "build:icons": "turbo run build --filter=@mache-hangar/icons",
    "build:components": "turbo run build --filter=@mache-hangar/components",
    "build:vue": "turbo run build --filter=vue-playground",
    "build:react": "turbo run build --filter=react-playground",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "publish": "turbo run build --filter=./packages/* && pnpm publish -r --filter=./packages/* --access public",
    "release": "changeset version && turbo run build && changeset publish",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
