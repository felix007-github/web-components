    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sass": "^1.95.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  }
}
