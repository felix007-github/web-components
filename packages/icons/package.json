{
  "name": "@mache-hangar/icons",
  "version": "0.1.3",
  "type": "module",
  "keywords": [
    "icon",
    "web-component"
  ],
  "description": "WT UI Icons collection",
  "homepage": "https://github.com/felix007-github/web-components/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/felix007-github/web-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felix007-github/web-components.git",
    "directory": "packages/icons"
  },
  "main": "dist/index.cjs.js",
  "module": "./index.js",
  "unpkg": "dist/esm/loader.js",
  "types": "./index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./dist/index.cjs.js",
      "default": "./index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./*": "./*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist/",
    "loader/"
  ],
  "typesVersions": {
    "*": {
      "loader": [
        "loader/index.d.ts"
      ],
      "loader/*": [
        "loader/*"
      ],
      "*": [
        "index.d.ts"
      ]
    }
  },
  "scripts": {
    "start": "stencil build --prod --es5 --watch --serve",
    "build": "pnpm run transform && stencil build --docs && pnpm run format:readmes",
    "format:readmes": "node ../../scripts/format-stencil-readmes.mjs",
    "test": "stencil test --spec --runInBand",
    "test:e2e": "stencil test --e2e",
    "test.watch": "stencil test --spec --watchAll",
    "generate": "stencil generate",
    "transform": "node scripts/transfer-svg.mjs",
    "clean": "node ../../scripts/tasks.cjs clean",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@stencil/core": "^4.43.4",
    "@types/jest": "^29.5.6",
    "@types/node": "^16.18.11",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.3.0",
    "svgo": "^3.0.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
