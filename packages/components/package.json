{
  "name": "@mache-hangar/components",
  "version": "0.1.3",
  "description": "WT UI Web Components 组件库：基于 Stencil 构建，提供 React / Vue 适配层与按需加载的 loader。",
  "keywords": [
    "web-components",
    "stencil",
    "design-system",
    "component-library",
    "react",
    "vue",
    "ui"
  ],
  "homepage": "https://github.com/felix007-github/web-components/tree/main/packages/components#readme",
  "bugs": {
    "url": "https://github.com/felix007-github/web-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felix007-github/web-components.git",
    "directory": "packages/components"
  },
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/lpcp-components/lpcp-components.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lpcp-components/lpcp-components.esm.js",
      "require": "./dist/cjs/lpcp-components.cjs.js"
    },
    "./core": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs.js"
    },
    "./react": {
      "types": "./output/react/index.d.ts",
      "import": "./output/react/index.js",
      "require": "./output/react-cjs/index.js"
    },
    "./vue": {
      "types": "./output/vue/index.d.ts",
      "import": "./output/vue/index.js",
      "require": "./output/vue-cjs/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    },
    "./dist/components/*": "./dist/components/*",
    "./dist/lpcp-components.css": "./dist/lpcp-components/lpcp-components.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "loader/",
    "output/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --filter @mache-hangar/icons build && stencil build --watch --serve",
    "build": "pnpm run build:stencil && pnpm run build:react && pnpm run build:vue",
    "build:stencil": "pnpm --filter @mache-hangar/icons build && pnpm run prepare:output-dirs && stencil build && pnpm run sync:component-assets",
    "sync:component-assets": "node ../../scripts/tasks.cjs sync-component-assets",
    "build:vue": "tsc -p tsconfig.vue.json && tsc -p tsconfig.vue.cjs.json",
    "build:react": "tsc -p tsconfig.react.json && tsc -p tsconfig.react.cjs.json",
    "prepare:output-dirs": "node ../../scripts/tasks.cjs prepare-output-dirs",
    "prepublishOnly": "pnpm run build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --runInBand",
    "test:e2e": "stencil test --e2e",
    "test.watch": "stencil test --spec --watchAll",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "node ../../scripts/tasks.cjs clean",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@stencil/react-output-target": "^1.5.2",
    "@stencil/vue-output-target": "^0.13.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mache-hangar/icons": "workspace:^",
    "@stencil/core": "^4.43.4",
    "@stencil/sass": "^3.2.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/react": "^19.1.10",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.3.0",
    "react": "^19.1.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.22"
  }
}
