{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@mache-hangar/components": ["dist/types/index.d.ts"],
      "@mache-hangar/components/core": ["dist/types/index.d.ts"],
      "@mache-hangar/components/loader": ["loader/index.d.ts"],
      "@mache-hangar/components/dist/components": ["dist/components/index.d.ts"],
      "@mache-hangar/components/dist/components/*": ["dist/components/*"]
    },
    "declaration": true,
    "rootDir": "./output/generated/vue",
    "outDir": "./output/vue",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["output/generated/vue/**/*.ts"],
  "exclude": ["node_modules"]
}
